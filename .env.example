# CycloVision AI V2 — Environment Variables Template
# Copy this file to .env and insert your personal API keys

# Telegram Bot Alert Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Twilio WhatsApp Alert Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_ALERT_NUMBERS=+919876543210,+919876543211

# Email Notification Configuration (Gmail SMTP)
ALERT_RECIPIENT_EMAIL=advisory@cyclovision.in
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Web Push Notification (VAPID RFC-8291)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIMS_EMAIL=mailto:admin@cyclovision.in

# ISRO MOSDAC / Satellite Portal Credentials (Optional)
MOSDAC_USER=research_cyclovision
MOSDAC_PASS=SecureMoES2026!
