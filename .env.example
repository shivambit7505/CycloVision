# ==============================================================================
# CycloVision AI V2 — Hackathon MVP Environment Configuration Template
# Copy this file to .env and configure your keys: copy .env.example .env
# ==============================================================================

# Server & Runtime Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Hardware & Training Acceleration (Auto-detected if unset)
# Values: 'cuda' (if NVIDIA GPU available), 'mps' (Apple Silicon), or 'cpu'
DEVICE=auto
FAST_CPU_THREADS=4
TRAINING_BATCH_SIZE=16
TRAINING_EPOCHS=10

# Database Persistence
CYCLOVISION_DB_PATH=v2/db/cyclovision_v2.db

# Open-Meteo & Satellite Data (Real-time weather feeds)
# Open-Meteo API is open-access and requires no key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Mapbox Satellite Basemap Service (Optional)
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# ISRO MOSDAC / Satellite Portal Credentials (Optional)
MOSDAC_API_KEY=your_mosdac_key_here
MOSDAC_USER=research_cyclovision
MOSDAC_PASS=SecureMoES2026!

# Google Gemini Synoptic Reasoning (Optional - fallback enabled)
GEMINI_API_KEY=your_gemini_api_key_here

# Web Push Notifications (RFC-8291 VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIMS_EMAIL=mailto:admin@cyclovision.in

# Emergency Alert Dispatchers (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886
ALERT_WHATSAPP_NUMBERS=+919876543210
ALERT_RECIPIENT_EMAIL=advisory@cyclovision.in
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
